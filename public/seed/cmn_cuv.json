{"translation": {"id": "cmn_cuv", "name": "新標點和合本", "website": "https://ebible.org/Scriptures/details.php?id=cmn-cu89t", "licenseUrl": "https://ebible.org/Scriptures/details.php?id=cmn-cu89t", "shortName": "CUV", "englishName": "Chinese Union Version (traditional)", "language": "cmn", "textDirection": "ltr", "sha256": "b09ecb193fd1362815827423111f334ec5394cc28bc0c4605b9daf64af6a6df8", "availableFormats": ["json"], "listOfBooksApiLink": "/api/cmn_cuv/books.json", "completeTranslationApiLink": "/api/cmn_cuv/complete.json", "simpleCompleteTranslationApiLink": "/api/cmn_cuv/complete.simple.json", "numberOfBooks": 66, "totalNumberOfChapters": 1189, "totalNumberOfVerses": 31021, "languageName": "中文", "languageEnglishName": "Chinese"}, "book": {"id": "EPH", "translationId": "cmn_cuv", "name": "以弗所書", "commonName": "以弗所書", "title": "以弗所書", "order": 49, "numberOfChapters": 6, "sha256": "db78a372ea9ca7349277c4e41277189d1fe5c012beeb7e181306765d4f5c7c8a", "firstChapterNumber": 1, "firstChapterApiLink": "/api/cmn_cuv/EPH/1.json", "firstChapterReference": {"translationId": "cmn_cuv", "book": "EPH", "chapter": 1}, "lastChapterNumber": 6, "lastChapterApiLink": "/api/cmn_cuv/EPH/6.json", "lastChapterReference": {"translationId": "cmn_cuv", "book": "EPH", "chapter": 6}, "totalNumberOfVerses": 154}, "chapter": {"number": 1, "content": [{"type": "heading", "content": ["問候"]}, {"type": "verse", "number": 1, "content": ["奉上帝旨意，作基督耶穌使徒的保羅，寫信給在以弗所的聖徒，就是在基督耶穌裏有忠心的人。"]}, {"type": "verse", "number": 2, "content": ["願恩惠、平安從上帝我們的父和主耶穌基督歸與你們！"]}, {"type": "heading", "content": ["基督裏的屬靈福氣"]}, {"type": "verse", "number": 3, "content": ["願頌讚歸與我們主耶穌基督的父上帝！他在基督裏曾賜給我們天上各樣屬靈的福氣："]}, {"type": "verse", "number": 4, "content": ["就如上帝從創立世界以前，在基督裏揀選了我們，使我們在他面前成為聖潔，無有瑕疵；"]}, {"type": "verse", "number": 5, "content": ["又因愛我們，就按着自己的意旨所喜悅的，預定我們藉着耶穌基督得兒子的名分，"]}, {"type": "verse", "number": 6, "content": ["使他榮耀的恩典得着稱讚；這恩典是他在愛子裏所賜給我們的。"]}, {"type": "verse", "number": 7, "content": ["我們藉這愛子的血得蒙救贖，過犯得以赦免，乃是照他豐富的恩典。"]}, {"type": "verse", "number": 8, "content": ["這恩典是上帝用諸般智慧聰明，充充足足賞給我們的；"]}, {"type": "verse", "number": 9, "content": ["都是照他自己所預定的美意，叫我們知道他旨意的奧祕，"]}, {"type": "verse", "number": 10, "content": ["要照所安排的，在日期滿足的時候，使天上、地上、一切所有的都在基督裏面同歸於一。"]}, {"type": "verse", "number": 11, "content": ["我們也在他裏面得", {"noteId": 0}, "了基業；這原是那位隨己意行、做萬事的，照着他旨意所預定的，"]}, {"type": "verse", "number": 12, "content": ["叫他的榮耀從我們這首先在基督裏有盼望的人可以得着稱讚。"]}, {"type": "verse", "number": 13, "content": ["你們既聽見真理的道，就是那叫你們得救的福音，也信了基督，既然信他，就受了所應許的聖靈為印記。"]}, {"type": "verse", "number": 14, "content": ["這聖靈是我們得基業的憑據", {"noteId": 1}, "，直等到上帝之民", {"noteId": 2}, "被贖，使他的榮耀得着稱讚。"]}, {"type": "heading", "content": ["保羅的禱告"]}, {"type": "verse", "number": 15, "content": ["因此，我既聽見你們信從主耶穌，親愛眾聖徒，"]}, {"type": "verse", "number": 16, "content": ["就為你們不住地感謝上帝。禱告的時候，常提到你們，"]}, {"type": "verse", "number": 17, "content": ["求我們主耶穌基督的上帝，榮耀的父，將那賜人智慧和啟示的靈賞給你們，使你們真知道他，"]}, {"type": "verse", "number": 18, "content": ["並且照明你們心中的眼睛，使你們知道他的恩召有何等指望，他在聖徒中得的基業有何等豐盛的榮耀；"]}, {"type": "verse", "number": 19, "content": ["並知道他向我們這信的人所顯的能力是何等浩大，"]}, {"type": "verse", "number": 20, "content": ["就是照他在基督身上所運行的大能大力，使他從死裏復活，叫他在天上坐在自己的右邊，"]}, {"type": "verse", "number": 21, "content": ["遠超過一切執政的、掌權的、有能的、主治的，和一切有名的；不但是今世的，連來世的也都超過了。"]}, {"type": "verse", "number": 22, "content": ["又將萬有服在他的腳下，使他為教會作萬有之首。"]}, {"type": "verse", "number": 23, "content": ["教會是他的身體，是那充滿萬有者所充滿的。"]}], "footnotes": [{"noteId": 0, "caller": "-", "text": "得：或譯成", "reference": {"chapter": 1, "verse": 11}}, {"noteId": 1, "caller": "-", "text": "原文是質", "reference": {"chapter": 1, "verse": 14}}, {"noteId": 2, "caller": "-", "text": "民：原文是產業", "reference": {"chapter": 1, "verse": 14}}]}, "thisChapterLink": "/api/cmn_cuv/EPH/1.json", "thisChapterReference": {"translationId": "cmn_cuv", "book": "EPH", "chapter": 1}, "thisChapterAudioLinks": {}, "nextChapterApiLink": "/api/cmn_cuv/EPH/2.json", "nextChapterReference": {"translationId": "cmn_cuv", "book": "EPH", "chapter": 2}, "nextChapterAudioLinks": {}, "previousChapterApiLink": "/api/cmn_cuv/GAL/6.json", "previousChapterReference": {"translationId": "cmn_cuv", "book": "GAL", "chapter": 6}, "previousChapterAudioLinks": {}, "thisChapterAudioTimings": {}, "nextChapterAudioTimings": {}, "previousChapterAudioTimings": {}, "numberOfVerses": 23, "simpleChapterApiLink": "/api/cmn_cuv/EPH/1.simple.json"}