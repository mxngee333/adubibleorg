{"translation": {"id": "cmn_cu1", "name": "新标点和合本", "website": "https://ebible.org/Scriptures/details.php?id=cmn-cu89s", "licenseUrl": "https://ebible.org/Scriptures/details.php?id=cmn-cu89s", "shortName": "CU1", "englishName": "Chinese Union Version (simplified)", "language": "cmn", "textDirection": "ltr", "sha256": "695cd78273e0ae8b7d4d8652df136647b8176716ed7279584f6bd047574676ff", "availableFormats": ["json"], "listOfBooksApiLink": "/api/cmn_cu1/books.json", "completeTranslationApiLink": "/api/cmn_cu1/complete.json", "simpleCompleteTranslationApiLink": "/api/cmn_cu1/complete.simple.json", "numberOfBooks": 66, "totalNumberOfChapters": 1189, "totalNumberOfVerses": 31021, "languageName": "中文", "languageEnglishName": "Chinese"}, "book": {"id": "EPH", "translationId": "cmn_cu1", "name": "以弗所书", "commonName": "以弗所书", "title": "以弗所书", "order": 49, "numberOfChapters": 6, "sha256": "2ac18dbf4261729a6066f17020268ade9794f1e51a047d656eaddb61447bb9b3", "firstChapterNumber": 1, "firstChapterApiLink": "/api/cmn_cu1/EPH/1.json", "firstChapterReference": {"translationId": "cmn_cu1", "book": "EPH", "chapter": 1}, "lastChapterNumber": 6, "lastChapterApiLink": "/api/cmn_cu1/EPH/6.json", "lastChapterReference": {"translationId": "cmn_cu1", "book": "EPH", "chapter": 6}, "totalNumberOfVerses": 154}, "chapter": {"number": 1, "content": [{"type": "heading", "content": ["问候"]}, {"type": "verse", "number": 1, "content": ["奉 神旨意，作基督耶稣使徒的保罗，写信给在以弗所的圣徒，就是在基督耶稣里有忠心的人。"]}, {"type": "verse", "number": 2, "content": ["愿恩惠、平安从 神我们的父和主耶稣基督归与你们！"]}, {"type": "heading", "content": ["基督里的属灵福气"]}, {"type": "verse", "number": 3, "content": ["愿颂赞归与我们主耶稣基督的父 神！他在基督里曾赐给我们天上各样属灵的福气："]}, {"type": "verse", "number": 4, "content": ["就如 神从创立世界以前，在基督里拣选了我们，使我们在他面前成为圣洁，无有瑕疵；"]}, {"type": "verse", "number": 5, "content": ["又因爱我们，就按着自己的意旨所喜悦的，预定我们借着耶稣基督得儿子的名分，"]}, {"type": "verse", "number": 6, "content": ["使他荣耀的恩典得着称赞；这恩典是他在爱子里所赐给我们的。"]}, {"type": "verse", "number": 7, "content": ["我们借这爱子的血得蒙救赎，过犯得以赦免，乃是照他丰富的恩典。"]}, {"type": "verse", "number": 8, "content": ["这恩典是 神用诸般智慧聪明，充充足足赏给我们的；"]}, {"type": "verse", "number": 9, "content": ["都是照他自己所预定的美意，叫我们知道他旨意的奥秘，"]}, {"type": "verse", "number": 10, "content": ["要照所安排的，在日期满足的时候，使天上、地上、一切所有的都在基督里面同归于一。"]}, {"type": "verse", "number": 11, "content": ["我们也在他里面得", {"noteId": 0}, "了基业；这原是那位随己意行、做万事的，照着他旨意所预定的，"]}, {"type": "verse", "number": 12, "content": ["叫他的荣耀从我们这首先在基督里有盼望的人可以得着称赞。"]}, {"type": "verse", "number": 13, "content": ["你们既听见真理的道，就是那叫你们得救的福音，也信了基督，既然信他，就受了所应许的圣灵为印记。"]}, {"type": "verse", "number": 14, "content": ["这圣灵是我们得基业的凭据", {"noteId": 1}, "，直等到 神之民", {"noteId": 2}, "被赎，使他的荣耀得着称赞。"]}, {"type": "heading", "content": ["保罗的祷告"]}, {"type": "verse", "number": 15, "content": ["因此，我既听见你们信从主耶稣，亲爱众圣徒，"]}, {"type": "verse", "number": 16, "content": ["就为你们不住地感谢 神。祷告的时候，常提到你们，"]}, {"type": "verse", "number": 17, "content": ["求我们主耶稣基督的 神，荣耀的父，将那赐人智慧和启示的灵赏给你们，使你们真知道他，"]}, {"type": "verse", "number": 18, "content": ["并且照明你们心中的眼睛，使你们知道他的恩召有何等指望，他在圣徒中得的基业有何等丰盛的荣耀；"]}, {"type": "verse", "number": 19, "content": ["并知道他向我们这信的人所显的能力是何等浩大，"]}, {"type": "verse", "number": 20, "content": ["就是照他在基督身上所运行的大能大力，使他从死里复活，叫他在天上坐在自己的右边，"]}, {"type": "verse", "number": 21, "content": ["远超过一切执政的、掌权的、有能的、主治的，和一切有名的；不但是今世的，连来世的也都超过了。"]}, {"type": "verse", "number": 22, "content": ["又将万有服在他的脚下，使他为教会作万有之首。"]}, {"type": "verse", "number": 23, "content": ["教会是他的身体，是那充满万有者所充满的。"]}], "footnotes": [{"noteId": 0, "caller": "-", "text": "得：或译成", "reference": {"chapter": 1, "verse": 11}}, {"noteId": 1, "caller": "-", "text": "原文是质", "reference": {"chapter": 1, "verse": 14}}, {"noteId": 2, "caller": "-", "text": "民：原文是产业", "reference": {"chapter": 1, "verse": 14}}]}, "thisChapterLink": "/api/cmn_cu1/EPH/1.json", "thisChapterReference": {"translationId": "cmn_cu1", "book": "EPH", "chapter": 1}, "thisChapterAudioLinks": {}, "nextChapterApiLink": "/api/cmn_cu1/EPH/2.json", "nextChapterReference": {"translationId": "cmn_cu1", "book": "EPH", "chapter": 2}, "nextChapterAudioLinks": {}, "previousChapterApiLink": "/api/cmn_cu1/GAL/6.json", "previousChapterReference": {"translationId": "cmn_cu1", "book": "GAL", "chapter": 6}, "previousChapterAudioLinks": {}, "thisChapterAudioTimings": {}, "nextChapterAudioTimings": {}, "previousChapterAudioTimings": {}, "numberOfVerses": 23, "simpleChapterApiLink": "/api/cmn_cu1/EPH/1.simple.json"}