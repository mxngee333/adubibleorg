# ====================================================================
# ADUBIBLE / ELOHIM BIBLE HUB — HETZNER CLUSTER ENVIRONMENT VARIABLES
# ====================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Number of cluster workers (leave empty to auto-detect all CPU cores)
WORKERS=8

# Upstream Cloudflare R2 Bucket URL (if syncing direct to R2)
R2_PUBLIC_URL=https://r2-scripture.adubible.org

# Allowed Origins
ALLOWED_ORIGINS=https://adubible.org,https://elohimbible.web.app
