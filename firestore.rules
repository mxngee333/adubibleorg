rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'mxngee@gmail.com' ||
        request.auth.token.email.matches('(?i)mxngee@gmail\\.com')
      );
    }

    match /users/{userId}/study_vault/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /newsletter_subscribers/{subId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow create: if request.resource.data.amount is number;
      allow read, update, delete: if isAdmin();
    }

    match /prayer_requests/{prayerId} {
      allow create: if request.resource.data.request is string;
      allow read, update, delete: if isAdmin();
    }

    match /system_metrics/{metricId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
