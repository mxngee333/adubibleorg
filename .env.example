# ====================================================================
# ADUBIBLE / ELOHIM BIBLE HUB — PLANETARY SCALE ENVIRONMENT CONFIG
# Target: 4 Billion Readers Worldwide
# ====================================================================

# 1. CANONICAL DOMAIN
VITE_SITE_URL=https://adubible.org

# 2. CLOUDFLARE PLANETARY EDGE & R2 ZERO-EGRESS STORAGE
# Cloudflare Edge Worker URL (e.g. https://edge.adubible.org or https://adubible-edge-worker.<subdomain>.workers.dev)
VITE_CLOUDFLARE_EDGE_URL=https://edge.adubible.org
# Direct Cloudflare R2 Public Bucket URL (Zero-Egress Scripture Vault)
VITE_R2_SCRIPTURE_URL=https://r2-scripture.adubible.org

# Cloudflare Wrangler Credentials (for scripts & deployments)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_R2_BUCKET_NAME=adubible-scripture-vault

# 3. HETZNER HIGH-THROUGHPUT DEDICATED ORIGIN CLUSTER
# Dedicated bare-metal server / Coolify cluster (e.g. https://origin.adubible.org)
VITE_HETZNER_ORIGIN_URL=https://origin.adubible.org

# 4. NEW FIREBASE PROJECT CONFIGURATION (AUTH & STUDY VAULT SYNC)
# Create a new project at https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_new_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-new-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-new-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-new-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID
