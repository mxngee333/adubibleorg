# ====================================================================
# ADUBIBLE / ELOHIM BIBLE HUB — PLANETARY SCALE ENVIRONMENT CONFIG
# Target: 4 Billion Readers Worldwide
# ====================================================================

# 1. CANONICAL DOMAIN
VITE_SITE_URL=https://adubible.org

# 2. CLOUDFLARE PLANETARY EDGE & R2 ZERO-EGRESS STORAGE
VITE_CLOUDFLARE_EDGE_URL=https://edge.adubible.org
VITE_R2_SCRIPTURE_URL=https://r2-scripture.adubible.org

# Cloudflare Account & R2 Storage Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_r2_api_token
CLOUDFLARE_R2_ACCESS_KEY_ID=your_s3_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_s3_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=adubible

# 3. MAILEROO TRANSACTIONAL EMAIL ENGINE
MAILEROO_API_KEY=your_maileroo_api_key
SMTP_FROM=AduBible <no-reply@adubible.org>

# 4. HETZNER HIGH-THROUGHPUT DEDICATED ORIGIN CLUSTER
VITE_HETZNER_ORIGIN_URL=https://origin.adubible.org

# 5. FIREBASE CONFIGURATION
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
